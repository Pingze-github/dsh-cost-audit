{
  "name": "dsh-stats",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Stats — per-turn and whole-session token / CNY cost / account-balance pills for the DeepSeek Harness Web GUI, in the official stats-pill form.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-credentials": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.5-rc.1"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "license": "MIT",
  "types": "index.d.ts"
}
